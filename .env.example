NEXT_PUBLIC_API_URL=http://localhost:8000
DASHSCOPE_API_KEY=
ASR_MODEL=paraformer-v2
ASR_POLL_INTERVAL_SECONDS=3
ASR_MAX_WAIT_SECONDS=1800
DASHSCOPE_BASE_URL=https://dashscope.aliyuncs.com/api/v1
EMBEDDING_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
EMBEDDING_MODEL=text-embedding-v2
DEEPSEEK_API_KEY=
SUMMARY_MODEL=deepseek-chat
SUMMARY_PROVIDER=deepseek
# Agent 独立模型：deepseek / dashscope / openai_compatible。
# 默认沿用 DEEPSEEK_API_KEY 和 SUMMARY_MODEL；其他生成任务仍使用原配置。
AGENT_PROVIDER=deepseek
AGENT_BASE_URL=
AGENT_API_KEY=
AGENT_MODEL=
# 可选：额外可选模型目录（JSON 数组）；不填时显示默认模型及已配置凭证的供应商预设。
AGENT_MODELS=[]
TOKEN_QUOTA_ENABLED=true
DAILY_TOKEN_LIMIT=100000
